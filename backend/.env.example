# WorkGuide 环境变量模板
# 复制本文件为 backend/.env 并填入你自己的密钥（.env 不会被 Git 跟踪）
# 不要在本文件或任何 git 跟踪文件中填写真实 Key

# 智谱 AI —— 一个示例模型服务商。WorkGuide 不默认绑定任何具体模型，
# 需要你在 config.yaml 中配置可用的 LLM 模型，再由模型项通过 $ZHIPU_API_KEY 引用本密钥。
ZHIPU_API_KEY=

# Tavily —— Web 搜索（Research Agent 联网搜索）
# config.yaml 中 tools.web_search.api_key: $TAVILY_API_KEY
TAVILY_API_KEY=

# 可选：显式指定 config.yaml 路径（不设置时自动在项目根目录查找）
# WORKGUIDE_CONFIG_PATH=/path/to/your/config.yaml